  "templates": [
    {
      "id": "T1",
      "name": "地域情報番組の情景カット",
      "models": [
        "veo3_1_lite",
        "kling3_0"
      ],
      "aspect": "16:9",
      "seconds": 8,
      "body": "{movement}, wide establishing shot. {season} morning over {place}. {weather}. Natural, documentary look, soft {lighting}, palette of {palette}. Gentle, unhurried pacing.\nAudio: {ambient}. No music."
    },
    {
      "id": "T2",
      "name": "職人の手元（文化番組）",
      "models": [
        "seedance_2_5",
        "veo3_1_lite"
      ],
      "aspect": "16:9",
      "seconds": 8,
      "body": "Macro close-up, static camera. The hands of {job} {action}. {place}, a single shaft of window light. Documentary style, shallow depth of field, 35mm film grain.\nAudio: {ambient}. No music."
    },
    {
      "id": "T3",
      "name": "CM（時間で区切る形）",
      "models": [
        "seedance_2_5",
        "minimax_h3"
      ],
      "aspect": "16:9",
      "seconds": null,
      "body": "GLOBAL STYLE: {style}. No music, no subtitles.\nSCENE: {logline}.\nCHARACTERS: {person} from the reference, identical features in every shot, zero drift.\nPRODUCT: inherited exactly from the reference: {details}. Lettering stays sharp and correctly spelled whenever visible.\nLOCATION: {location}.\nFORMAT: {n} segments, hard cuts only.\n{shots}\nAUDIO: {sfx}. No BGM.",
      "note": "ショット数は内容で決める"
    },
    {
      "id": "T4",
      "name": "スポーツダイジェストのイメージ",
      "models": [
        "kling3_0"
      ],
      "aspect": "16:9",
      "seconds": 5,
      "body": "Low angle, slow motion. An empty indoor {sport} arena just before a match, spotlights sweeping across the court, dust particles floating in the beams. The camera slowly pushes in toward {target}. Dramatic, high-contrast lighting, palette of {palette}.\nAudio: deep cinematic boom, distant crowd anticipation. No music."
    },
    {
      "id": "T5",
      "name": "写真を動かす（I2V）",
      "models": [
        "kling3_0",
        "veo3_1_lite"
      ],
      "aspect": "source",
      "seconds": 5,
      "body": "Subtle parallax push-in. {moving_elements}. The people stay mostly still. Camera movement stays slow and smooth."
    },
    {
      "id": "T6",
      "name": "縦型ショート告知",
      "models": [
        "seedance_2_5",
        "kling3_0"
      ],
      "aspect": "9:16",
      "seconds": 8,
      "body": "Vertical 9:16 framing, subject centered. Handheld, energetic, quick whip pan between beats.\nBeat 1: {highlight1}.\nBeat 2: whip pan to {highlight2}.\nBeat 3: {person} turns to camera and says in Japanese: \"{line}\"\nVibrant, saturated colors, smartphone vlog look.\nAudio: crowd ambience, a whoosh on each whip pan. No music."
    },
    {
      "id": "T7",
      "name": "再現VTR",
      "models": [
        "seedance_2_5"
      ],
      "aspect": "16:9",
      "seconds": 12,
      "body": "Style: {era} Japanese home drama, warm faded film look.\n{setting}.\nCamera: static medium shot, eye level.\nBeats: (1) {beat1}, (2) {beat2}, (3) {beat3}.\nLighting: {lighting}. Palette: {palette}.\nDialogue:\n- {speaker} ({tone}): \"{line}\" No music."
    },
    {
      "id": "T8",
      "name": "トランジション素材",
      "models": [
        "veo3_1_lite",
        "kling3_0"
      ],
      "aspect": "16:9",
      "seconds": 3,
      "body": "Seamless match cut from {from} to {to}, macro close-up, shallow depth of field, soft pastel light."
    },
    {
      "id": "T9",
      "name": "商品の見せ場（開始と終了の画像）",
      "models": [
        "minimax_h3",
        "seedance_2_5",
        "kling3_0"
      ],
      "aspect": "16:9",
      "seconds": null,
      "body": "The camera holds the same angle and the same lens perspective. {action}. The product keeps its exact shape, color, label and proportions in every frame; the pedestal stays the same size, height and position. Lighting on the product does not change. Audio: {sfx}. No music."
    },
    {
      "id": "T10",
      "name": "会話シーン（台詞を音声で渡す）",
      "models": [
        "seedance_2_5"
