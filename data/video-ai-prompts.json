{
  "version": 1,
  "updated": "2026-10-22",
  "note": "Human-readable source: docs/video-ai/. Values marked verified:false come from third-party articles; check vendor docs before relying on them.",
  "promptOrder": ["camera", "subject", "action", "setting", "lighting", "style", "audio"],
  "vocab": {
    "shotSize": [
      { "jp": "超クローズアップ", "en": "extreme close-up" },
      { "jp": "クローズアップ", "en": "close-up" },
      { "jp": "バストショット", "en": "medium close-up" },
      { "jp": "ミディアムショット", "en": "medium shot" },
      { "jp": "フルショット", "en": "full shot" },
      { "jp": "引き・状況説明", "en": "wide establishing shot" },
      { "jp": "超ロング", "en": "extreme wide shot" },
      { "jp": "肩越し", "en": "over-the-shoulder shot" },
      { "jp": "主観", "en": "point-of-view shot" },
      { "jp": "マクロ", "en": "macro close-up" }
    ],
    "angle": [
      { "jp": "目線の高さ", "en": "eye level" },
      { "jp": "あおり", "en": "low angle" },
      { "jp": "俯瞰", "en": "high angle" },
      { "jp": "真上から", "en": "bird's-eye view" },
