      { "jp": "斜め傾け", "en": "Dutch angle" }
    ],
    "movement": [
      { "jp": "フィックス", "en": "static shot" },
      { "jp": "パン", "en": "slow pan right" },
      { "jp": "ティルトアップ", "en": "tilt up" },
      { "jp": "ドリーイン", "en": "slow dolly-in" },
      { "jp": "ドリーアウト", "en": "dolly-out" },
      { "jp": "トラック", "en": "truck left" },
      { "jp": "クレーン", "en": "crane up" },
      { "jp": "空撮", "en": "aerial drone shot" },
      { "jp": "追従", "en": "tracking shot, camera follows from behind" },
      { "jp": "回り込み", "en": "orbit around the subject" },
      { "jp": "手持ち", "en": "handheld" },
      { "jp": "ウィップパン", "en": "whip pan" },
      { "jp": "めまいショット", "en": "dolly zoom" },
      { "jp": "フォーカス送り", "en": "rack focus" }
    ],
    "lighting": [
      { "jp": "夕景・マジックアワー", "en": "golden hour" },
      { "jp": "ブルーアワー", "en": "blue hour" },
      { "jp": "曇天の柔らかい光", "en": "overcast soft light" },
      { "jp": "逆光", "en": "backlit" },
      { "jp": "輪郭光", "en": "rim light" },
      { "jp": "窓明かり", "en": "soft window light" },
      { "jp": "電球色", "en": "warm tungsten light" },
      { "jp": "ネオン", "en": "neon glow" },
      { "jp": "光の筋", "en": "volumetric light through haze" }
    ],
    "style": [
      { "jp": "ドキュメンタリー", "en": "documentary style" },
      { "jp": "映画風", "en": "cinematic" },
      { "jp": "フィルム調", "en": "35mm film grain" },
      { "jp": "CM・クリーン", "en": "clean commercial look" },
      { "jp": "90年代テレビ", "en": "1990s TV broadcast look" },
      { "jp": "アニメ", "en": "Japanese anime style" },
      { "jp": "スマホVlog", "en": "smartphone vlog look" },
      { "jp": "クレイアニメ", "en": "stop-motion claymation" }
    ],
    "negativeDefaults": ["text", "subtitles", "watermark", "logo", "distorted hands"]
  },
  "models": [
    {
      "id": "veo-3.1",
      "name": "Google Veo 3.1 / Gemini Omni Flash",
      "modes": ["t2v", "i2v", "first-last-frame", "ref", "extend", "edit"],
      "audio": true,
      "negativePrompt": true,
      "syntax": { "dialogue": "The {speaker} says: {line}", "audio": "separate sentences" },
      "verified": true,
      "source": "https://docs.cloud.google.com/vertex-ai/generative-ai/docs/video/video-gen-prompt-guide"
    },
    {
      "id": "sora-2",
      "name": "OpenAI Sora 2 / Sora 2 Pro",
      "modes": ["t2v", "i2v", "extend"],
      "seconds": [4, 8, 12, 16, 20],
      "sizes": {
        "sora-2": ["1280x720", "720x1280"],
        "sora-2-pro": ["1280x720", "720x1280", "1792x1024", "1024x1792", "1920x1080", "1080x1920"]
      },
      "audio": true,
      "negativePrompt": false,
      "syntax": { "dialogue": "Dialogue: block, one line per speaker", "beats": "(1) ... (2) ..." },
      "verified": true,
      "source": "https://developers.openai.com/cookbook/examples/sora/sora2_prompting_guide"
    },
    {
      "id": "kling-3.0",
      "name": "Kling 3.0",
      "modes": ["t2v", "i2v", "ref"],
      "maxSeconds": 15,
      "maxShots": 6,
      "audio": true,
      "syntax": { "shot": "Shot {n} (Duration: {s} seconds): ...", "dialogue": "[Name] (tone, language): \"line\"" },
      "verified": true,
      "source": "https://blog.fal.ai/kling-3-0-prompting-guide/"
    },
    {
      "id": "runway-gen-4.5",
      "name": "Runway Gen-4.5",
      "modes": ["t2v", "i2v"],
      "minSeconds": 2,
      "maxSeconds": 10,
      "aspects": ["16:9", "9:16"],
      "syntax": { "i2v": "describe motion only, not appearance" },
      "verified": false,
      "source": "https://runware.ai/docs/models/runway-gen-4-5/guides/directing-motion"
    },
    {
      "id": "seedance-2.0",
      "name": "Seedance 2.0 (2.5: up to 30s, 50 refs)",
      "modes": ["t2v", "i2v", "ref", "edit"],
      "minSeconds": 5,
      "maxSeconds": 15,
      "maxRefs": { "image": 9, "video": 3, "audio": 3 },
      "resolutions": ["480p", "720p", "1080p"],
      "audio": true,
      "syntax": {
        "shot": "Shot {n}: ...",
        "ref": "@Image 1 / @Video 1 / @Audio 1",
        "dialogue": "{line}",
        "music": "(music)",
        "sfx": "<sound effect>",
        "subtitle": "「subtitle」",
        "constraints": "at the end, e.g. Keep it subtitle-free, do not generate a logo or watermark."
      },
      "verified": true,
      "source": "https://runway.com/resources/seedance-2-0-prompt-guide"
    },
    {
      "id": "wan-2.7",
      "name": "Wan 2.7 (open weights, Apache 2.0)",
      "modes": ["t2v", "i2v", "first-last-frame"],
      "maxSeconds": 15,
      "audio": true,
      "local": true,
      "verified": false,
      "source": "https://videogen.io/best-ai-video-models"
    }
  ],
  "templates": [
    { "id": "T1", "name": "地域情報番組の情景カット", "models": ["veo-3.1", "kling-3.0"], "aspect": "16:9", "seconds": 8,
      "body": "{movement}, wide establishing shot. {season} morning over {place}. {weather}. Natural, documentary look, soft {lighting}, palette of {palette}. Gentle, unhurried pacing.\nAudio: {ambient}. No music." },
    { "id": "T2", "name": "職人の手元（文化番組）", "models": ["sora-2", "veo-3.1"], "aspect": "16:9", "seconds": 8,
      "body": "Macro close-up, static camera. The hands of {job} {action}. {place}, a single shaft of window light. Documentary style, shallow depth of field, 35mm film grain.\nAudio: {ambient}." },
    { "id": "T3", "name": "CM 15秒・3ショット", "models": ["kling-3.0", "seedance-2.0"], "aspect": "16:9", "seconds": 15,
      "body": "Shot 1: Wide shot, slow dolly-in. {scene1}.\nShot 2: Medium shot, tracking. {hero} {action}.\nShot 3: Close-up, static. {hero} looks into the camera and says in Japanese {\"{catchcopy}\"}.\nBright, clean commercial look, warm natural light, palette of {palette}.\n(upbeat acoustic guitar music)\nKeep it subtitle-free, do not generate a logo or watermark." },
    { "id": "T4", "name": "スポーツダイジェストのイメージ", "models": ["kling-3.0"], "aspect": "16:9", "seconds": 5,
      "body": "Low angle, slow motion. An empty indoor {sport} arena just before a match, spotlights sweeping across the court, dust particles floating in the beams. The camera slowly pushes in toward {target}. Dramatic, high-contrast lighting, palette of {palette}.\nAudio: deep cinematic boom, distant crowd anticipation." },
    { "id": "T5", "name": "写真を動かす（I2V）", "models": ["runway-gen-4.5", "veo-3.1", "kling-3.0"], "aspect": "source", "seconds": 5,
      "body": "Subtle parallax push-in. {moving_elements}. The people stay mostly still. Camera movement stays slow and smooth." },
    { "id": "T6", "name": "縦型ショート告知", "models": ["sora-2", "kling-3.0"], "aspect": "9:16", "seconds": 8,
      "body": "Vertical 9:16 framing, subject centered. Handheld, energetic, quick whip pan between beats.\nBeat 1: {highlight1}.\nBeat 2: whip pan to {highlight2}.\nBeat 3: {person} turns to camera and says in Japanese: \"{line}\"\nVibrant, saturated colors, smartphone vlog look.\nAudio: crowd ambience, a whoosh on each whip pan." },
    { "id": "T7", "name": "再現VTR", "models": ["sora-2"], "aspect": "16:9", "seconds": 12,
      "body": "Style: {era} Japanese home drama, warm faded film look.\n{setting}.\nCamera: static medium shot, eye level.\nBeats: (1) {beat1}, (2) {beat2}, (3) {beat3}.\nLighting: {lighting}. Palette: {palette}.\nDialogue:\n- {speaker} ({tone}): \"{line}\"" },
    { "id": "T8", "name": "トランジション素材", "models": ["veo-3.1", "kling-3.0"], "aspect": "16:9", "seconds": 3,
      "body": "Seamless match cut from {from} to {to}, macro close-up, shallow depth of field, soft pastel light." }
  ],
  "steps": [
    { "code": "AP", "jp": "AIカット設計", "en": "AI Shot Planning", "defaultHours": 1 },
    { "code": "AG", "jp": "AI生成・選別", "en": "AI Generation", "defaultHours": 2 },
    { "code": "AF", "jp": "AI素材仕上げ", "en": "AI Finishing", "defaultHours": 1 }
  ]
}
